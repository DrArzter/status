  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260915.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.2"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20260911.1": true,
    "esbuild@0.28.1": true
  }
